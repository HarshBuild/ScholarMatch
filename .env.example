# ──────────────────────────────────────────────────────────────
# Firebase web app configuration.
# Copy this file to ".env" and fill in the values from your
# Firebase Console → Project Settings → General → "Your apps".
# NEVER commit the real .env file. It is git-ignored.
# ──────────────────────────────────────────────────────────────

# These MUST be prefixed with VITE_ so Vite exposes them to the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ──────────────────────────────────────────────────────────────
# Groq API key for the ingestion pipeline's LLM eligibility extraction
# AND the client-side AI Scholarship Finder. The VITE_ prefix exposes
# it to the browser bundle.
# Optional — if omitted, the pipeline uses a heuristic parser and the
# AI Finder is disabled.
# ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
VITE_GROQ_API_KEY=
